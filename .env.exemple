# Liste des secrets du projet, avec des valeurs factices (fichier versionné).
# Le Vagrantfile crée .env à partir de ces NOMS, avec des valeurs aléatoires :
# pour ajouter un secret, ajoutez une ligne ici. .env n'est JAMAIS versionné.
PG_ADMIN_MDP=a_remplacer
PG_APP_MDP=a_remplacer
PG_REPLICATION_MDP=a_remplacer
HAPROXY_STATS_MDP=a_remplacer
